{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null && data.child('players').child(auth.uid).exists()",
        "created": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },
        "size": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && root.child('rooms').child($code).child('created').val() === auth.uid",
          ".validate": "newData.isNumber() && (newData.val() === 2 || newData.val() === 4)"
        },
        "target": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && root.child('rooms').child($code).child('created').val() === auth.uid",
          ".validate": "newData.isNumber() && (newData.val() === 11 || newData.val() === 21)"
        },
        "seats": {
          ".read": "auth != null",
          "$seat": {
            ".write": "auth != null && !data.exists() && newData.val() === auth.uid && !root.child('rooms').child($code).child('closed').exists() && root.child('rooms').child($code).child('created').exists() && root.child('rooms').child($code).child('created').val() !== auth.uid && root.child('rooms').child($code).child('seats').child('1').val() !== auth.uid && root.child('rooms').child($code).child('seats').child('2').val() !== auth.uid && root.child('rooms').child($code).child('seats').child('3').val() !== auth.uid && ($seat === '1' || (root.child('rooms').child($code).child('size').val() === 4 && ($seat === '2' || $seat === '3')))"
          }
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && newData.exists() && !root.child('rooms').child($code).child('closed').exists() && (root.child('rooms').child($code).child('created').val() === auth.uid || root.child('rooms').child($code).child('seats').child('1').val() === auth.uid || root.child('rooms').child($code).child('seats').child('2').val() === auth.uid || root.child('rooms').child($code).child('seats').child('3').val() === auth.uid)",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16"
          }
        },
        "state": {
          ".write": "auth != null && newData.exists() && !root.child('rooms').child($code).child('closed').exists() && root.child('rooms').child($code).child('players').child(auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().length < 30000"
        },
        "online": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean() || newData.isNumber()"
          }
        },
        "closed": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && root.child('rooms').child($code).child('players').child(auth.uid).exists()",
          ".validate": "newData.isNumber()"
        },
        "$other": { ".validate": false }
      }
    },
    "matches": {
      "$group": {
        ".read": "auth != null",
        "$matchId": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.hasChildren(['w', 't']) && newData.child('w').isString() && newData.child('w').val().length > 0 && newData.child('w').val().length <= 16 && newData.child('t').isNumber()"
        }
      }
    },
    "results": {
      "$group": {
        ".read": "auth != null",
        "$gameId": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.hasChildren(['w', 't']) && newData.child('w').isString() && newData.child('w').val().length <= 16 && newData.child('t').isNumber()"
        }
      }
    }
  }
}
