{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null && data.child('players').child(auth.uid).exists()",
        "created": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && newData.exists() && (data.exists() || (root.child('rooms').child($code).child('created').exists() && root.child('rooms').child($code).child('players').numChildren() < 2))",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16"
          }
        },
        "state": {
          ".write": "auth != null && newData.exists() && root.child('rooms').child($code).child('players').child(auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().length < 20000"
        },
        "online": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          }
        },
        "$other": { ".validate": false }
      }
    },
    "results": {
      "$pair": {
        ".read": "auth != null",
        "$gameId": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.hasChildren(['w', 't']) && newData.child('w').isString() && newData.child('w').val().length <= 16 && newData.child('t').isNumber()"
        }
      }
    }
  }
}
